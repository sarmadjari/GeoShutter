---
import BaseLayout from "../layouts/BaseLayout.astro";

// GeoShutter is a standalone app based on Alpha GPS by Saschl (GPL-3.0). It isn't in the
// app stores yet: the page points to the source and the build instructions, and credits
// Alpha GPS (with links to the original app) in its own section.
const siteUrl = "https://geoshutter.sarmad.no/";
const repoUrl = "https://github.com/sarmadjari/GeoShutter";
const issuesUrl = `${repoUrl}/issues`;
const installUrl = `${repoUrl}#install`;
const releasesUrl = `${repoUrl}/releases`;
const privacyUrl = `${repoUrl}/blob/main/privacy.md`;
const fujifilmDocUrl = `${repoUrl}/blob/main/docs/fujifilm-protocol.md`;
const alphaGpsSiteUrl = "https://alphagps.app/";
const alphaGpsRepoUrl = "https://github.com/Saschl/alpha-gps";
const alphaGpsPlayUrl = "https://play.google.com/store/apps/details?id=com.saschl.cameragps";
const alphaGpsAppStoreUrl = "https://apps.apple.com/us/app/alpha-gps-camera-geotagging/id6760982303";
const furbleUrl = "https://github.com/gkoh/furble";
const supportUrl = "https://buymeacoffee.com/wj8tism4dq";
const topNav = {
  brand: "GeoShutter",
  homeUrl: "/",
  logoSrc: "/icon.svg",
  repoUrl,
  issuesUrl,
  starsBadgeUrl: "https://img.shields.io/github/stars/sarmadjari/GeoShutter?style=for-the-badge&logo=github&cacheSeconds=7200",
  forksBadgeUrl: "https://img.shields.io/github/forks/sarmadjari/GeoShutter?style=for-the-badge&logo=github"
};

// Keep in sync with "Supported cameras" in the repository README.
const testedCameras = [
  {
    name: "Fujifilm X100VI",
    detail: "geotagging, date, time and time zone, the camera's location sync and power-off connection settings, standby, location intervals"
  },
  {
    name: "Sony α1 II (ILCE-1M2)",
    detail: "geotagging, time sync, keeping the camera awake, location intervals, switched-off detection"
  }
];
const upstreamCameras = ["A1", "A7 V", "A6400", "A6700", "ZV-E10"];

const minIos = "iOS 18.0";
const minAndroid = "Android 8.0";
const features = [
  "Automatic GPS geotagging over Bluetooth, for Sony and Fujifilm cameras",
  "Automatic reconnect when the camera is switched on, also in the background and with the phone locked",
  "Camera date, time and time zone sync",
  "Several cameras at the same time",
  "Per-camera settings for how often the location is updated and for the camera's own location and time settings",
  "Status notification, Quick Settings tile and home-screen widget (Android)",
  "Home-screen widget and Control Center control (iPhone)",
  "Bluetooth remote shutter (Sony)"
];
const fujifilmFeatures = [
  "The camera asks for your location itself, every 10 seconds by default (adjustable from 10 s to 8 min). Your phone's GPS follows its pace.",
  "Sets the camera's date, time, time zone (AREA SETTING) and daylight saving time from your phone when it is switched on.",
  "Reads and changes the camera's Smartphone location sync and Connect while power off settings from the app.",
  "Standby keeps a camera that is switched off or asleep connected and its location up to date (once a minute by default), so the first photo after switching it on is tagged right away.",
  "Shows each state at a glance: receiving (green), standby (blue), location sync off (amber), not connected (red)."
];

// Rendered on the page and as FAQPage JSON-LD, so both always say the same.
const faq = [
  {
    question: "How is GeoShutter related to Alpha GPS?",
    answer: "GeoShutter is a standalone app based on Alpha GPS by Saschl, and open source under the same GPL-3.0 license. It adds Fujifilm support, Sony power handling and a new interface, has its own app ID and installs next to Alpha GPS."
  },
  {
    question: "Which cameras work?",
    answer: `Sony cameras that can receive location information from Imaging Edge Mobile or Creators' App, and Fujifilm cameras that sync their location with FUJIFILM XApp (current firmware). GeoShutter is tested on the Fujifilm X100VI and the Sony α1 II. Users of Alpha GPS reported the Sony ${upstreamCameras.join(", ")}.`
  },
  {
    question: "How do I install it?",
    answer: "GeoShutter isn't in the app stores yet. Build it from source with the instructions in the repository. Ready-made Android APKs will be published on GitHub Releases."
  },
  {
    question: "Does it work on iPhone?",
    answer: `Yes. The iPhone app (${minIos} or later) supports Sony and Fujifilm cameras. Fujifilm on iPhone is new. A first test paired and set up the X100VI. The Android app needs ${minAndroid} or later.`
  },
  {
    question: "Does it keep geotagging in the background?",
    answer: "Yes. Pair the camera once, and the app reconnects automatically whenever you switch the camera on. It keeps sending the location while the app is in the background and the phone is locked. On Android 8 to 11, turn on Always On for the camera."
  },
  {
    question: "Why are the first photos after switching my Sony camera on untagged?",
    answer: "A Sony camera ends the Bluetooth connection when it is switched on and takes a location only after the phone has reconnected, about 10 seconds later. It also ends the connection in power save, so photos right after waking it are affected too. To avoid that, turn on Keep the camera awake in its details."
  },
  {
    question: "Is it free?",
    answer: "Yes. It is free, open source (GPL-3.0) and has no ads and no account. Your location is only used to geotag photos on your camera, and error reports are only sent if you allow them."
  }
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "GeoShutter",
    applicationCategory: "PhotographyApplication",
    operatingSystem: "Android, iOS",
    description:
      "Open-source app that sends your phone's GPS position to Sony and Fujifilm cameras over Bluetooth, so every photo is geotagged.",
    url: siteUrl,
    sameAs: [repoUrl],
    featureList: features,
    isBasedOn: { "@type": "SoftwareApplication", name: "Alpha GPS", url: alphaGpsSiteUrl },
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    author: { "@type": "Person", name: "Sarmad Jari" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer }
    }))
  }
];
---

<BaseLayout
  title="GeoShutter: Open-source geotagging for Sony and Fujifilm cameras"
  description="GeoShutter sends your phone's GPS position to Sony and Fujifilm cameras over Bluetooth, so every photo is geotagged. Open source, on Android and iPhone."
  jsonLd={jsonLd}
  nav={topNav}
>
  <section class="hero">
    <h1>GeoShutter</h1>
    <p class="lead">
      Open-source geotagging for Sony and Fujifilm cameras, on Android and iPhone.
      Pair your camera once, and every photo gets your phone's GPS position,
      automatically, over Bluetooth.
    </p>
    <p class="muted">
      Tested on the Fujifilm X100VI and the Sony α1 II. Free, no ads, no account.
    </p>
    <div class="actions">
      <a class="button" href={installUrl}>How to install</a>
      <a class="button ghost" href={repoUrl}>Source code</a>
      <a class="button ghost" href={releasesUrl}>Releases</a>
    </div>
  </section>

  <section>
    <h2>Why photographers use it</h2>
    <div class="grid">
      <article class="card">
        <h3>Set and forget</h3>
        <p>
          Reconnects on its own whenever you switch the camera on, keeps the location
          flowing in the background and with the phone locked, and shows at a glance
          which cameras receive it.
        </p>
      </article>
      <article class="card">
        <h3>Fujifilm, built in</h3>
        <p>
          Speaks Fujifilm's own geotagging protocol. The camera asks for your location,
          and GeoShutter sets its clock and time zone and keeps the location ready while
          the camera sleeps. <a href="#fujifilm">More about Fujifilm</a>.
        </p>
      </article>
      <article class="card">
        <h3>Sony, the way Sony's apps do it</h3>
        <p>
          Uses the same Bluetooth location feature as Imaging Edge Mobile and Creators'
          App, can keep the camera awake so no photo misses its location, and works as a
          remote shutter.
        </p>
      </article>
    </div>
  </section>

  <section>
    <h2>Features</h2>
    <p>
      For iPhones with {minIos} or later and Android phones with {minAndroid} or later
      (automatic background reconnect needs Android 12 or later, or Always On mode on
      older versions).
    </p>
    <ul>
      {features.map((feature) => <li>{feature}</li>)}
    </ul>
  </section>

  <section id="fujifilm">
    <h2>Fujifilm support</h2>
    <p>
      GeoShutter geotags Fujifilm cameras that sync their location with FUJIFILM XApp,
      on firmware with Fujifilm's secured Bluetooth connection. It is tested on the
      X100VI with Android. The iPhone app has the same support, and a first test paired
      and set up the X100VI.
    </p>
    <ul>
      {fujifilmFeatures.map((feature) => <li>{feature}</li>)}
    </ul>
    <p class="muted">
      The protocol is based on <a href={furbleUrl}>furble</a> and documented, with how
      each detail was verified, in the <a href={fujifilmDocUrl}>Fujifilm protocol reference</a>.
    </p>
  </section>

  <section id="cameras">
    <h2>Supported cameras</h2>
    <p>Tested with GeoShutter:</p>
    <ul>
      {testedCameras.map((camera) => (
        <li><strong>{camera.name}</strong><span class="muted">: {camera.detail}</span></li>
      ))}
    </ul>
    <p>
      <strong>Sony:</strong> cameras that can receive location information from Imaging
      Edge Mobile or Creators' App should work, because GeoShutter uses the same
      Bluetooth feature. Users of Alpha GPS reported: {upstreamCameras.join(", ")}.
    </p>
    <p>
      <strong>Fujifilm:</strong> cameras that geotag through FUJIFILM XApp with current
      firmware should work. So far only the X100VI is tested, with Android.
    </p>
    <p class="muted">
      Using a camera that isn't listed? <a href={issuesUrl}>Let us know</a> whether it
      works, so it can be added.
    </p>
  </section>

  <section id="faq" class="faq">
    <h2>Frequently asked questions</h2>
    {faq.map(({ question, answer }) => (
      <>
        <h3>{question}</h3>
        <p>{answer}</p>
      </>
    ))}
  </section>

  <section>
    <h2>Open source</h2>
    <p>
      GeoShutter is open source under the GPL-3.0. You can read the code, report
      problems and propose improvements on GitHub. No paywalls, no ads, no data selling.
    </p>
    <div class="actions">
      <a class="button" href={repoUrl}>Source code</a>
      <a class="button ghost" href={issuesUrl}>Issue tracker</a>
    </div>
  </section>

  <section>
    <h2>Privacy first</h2>
    <ul>
      <li>No advertising, no account and no data selling.</li>
      <li>Location is used only while a camera takes it, for live geotagging on your camera.</li>
      <li>Error reports are opt-in, and the FOSS Android build has no error reporting at all.</li>
    </ul>
    <p class="muted">
      Full details: <a href={privacyUrl}>Privacy Policy</a>
    </p>
  </section>

  <section id="credits">
    <h2>Credits</h2>
    <p>
      GeoShutter is based on <a href={alphaGpsSiteUrl}>Alpha GPS</a> by Saschl and its
      contributors (<a href={alphaGpsRepoUrl}>source</a>, GPL-3.0). The original app is on
      the <a href={alphaGpsAppStoreUrl}>App Store</a> and{" "}
      <a href={alphaGpsPlayUrl}>Google Play</a>. The Fujifilm support is based on{" "}
      <a href={furbleUrl}>furble</a> by Guo-Rong Koh (MIT License).
    </p>
    <p>
      If GeoShutter helps your photography, consider supporting the author of Alpha GPS.
    </p>
    <div class="actions">
      <a class="button ghost" href={supportUrl}>Buy Saschl a coffee</a>
    </div>
    <small>GeoShutter is made by Sarmad Jari, based on Alpha GPS by Saschl and contributors.</small>
  </section>
</BaseLayout>
