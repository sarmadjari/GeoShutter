---
import BaseLayout from "../layouts/BaseLayout.astro";

// GeoShutter is a fork of Alpha GPS. The app still ships as Alpha GPS, so the
// store listings, APK releases and app JSON-LD below describe the published
// Alpha GPS app, while repository/issue/privacy links point to the fork.
const repoUrl = "https://github.com/sarmadjari/GeoShutter";
const issuesUrl = `${repoUrl}/issues`;
const privacyUrl = `${repoUrl}/blob/main/privacy.md`;
const upstreamRepoUrl = "https://github.com/Saschl/alpha-gps";
const upstreamSiteUrl = "https://alphagps.app/";
const releasesUrl = `${upstreamRepoUrl}/releases`;
const playStoreUrl = "https://play.google.com/store/apps/details?id=com.saschl.cameragps";
const appStoreId = "6760982303";
const appStoreUrl = `https://apps.apple.com/us/app/alpha-gps-camera-geotagging/id${appStoreId}`;
const weblateUrl = "https://hosted.weblate.org/engage/alpha-gps/";
const supportUrl = "https://buymeacoffee.com/wj8tism4dq";
const topNav = {
  brand: "GeoShutter",
  homeUrl: "/",
  logoSrc: "/icon.svg",
  repoUrl,
  issuesUrl,
  starsBadgeUrl: "https://img.shields.io/github/stars/sarmadjari/GeoShutter?style=for-the-badge&logo=github&cacheSeconds=7200",
  forksBadgeUrl: "https://img.shields.io/github/forks/sarmadjari/GeoShutter?style=for-the-badge&logo=github"
};

// Confirmed by user reports. Keep in sync with "Supported cameras" in the repo
// README.
const confirmedCameras = [
  { name: "A1", code: "ILCE-1" },
  { name: "A7 V", code: "ILCE-7M5" },
  { name: "A6400", code: "ILCE-6400" },
  { name: "A6700", code: "ILCE-6700" },
  { name: "ZV-E10", code: "ZV-E10" }
];
const confirmedCameraNames = confirmedCameras.map((camera) => camera.name).join(", ");

const minIos = "iOS 18.0";
const minAndroid = "Android 8.0";
const features = [
  "Automatic GPS geotagging over Bluetooth",
  "Automatic reconnect when the camera is switched on",
  "Location updates in the background and with the phone locked",
  "Camera date, time and time zone sync",
  "Several cameras at the same time",
  "Bluetooth remote shutter"
];

// Rendered on the page and as FAQPage JSON-LD, so both always say the same.
const faq = [
  {
    question: "How are GeoShutter and Alpha GPS related?",
    answer: "GeoShutter is an open-source fork of Alpha GPS by Saschl. The code still ships as Alpha GPS, so the store buttons on this page install Alpha GPS."
  },
  {
    question: "Does it work on iPhone?",
    answer: `Yes. Alpha GPS is on the App Store for iPhone (${minIos} or later) and on Google Play for Android (${minAndroid} or later). Both versions are free.`
  },
  {
    question: "Which Sony cameras are supported?",
    answer: `Any Sony camera that can receive location information from Imaging Edge Mobile or Creators' App should work, because the app uses the same Bluetooth location feature. Confirmed by users so far: ${confirmedCameraNames}.`
  },
  {
    question: "Does it keep geotagging in the background?",
    answer: "Yes. Pair the camera once, and the app reconnects automatically whenever you switch the camera on. It keeps sending location while the app is in the background and the phone is locked. On Android 8 to 11, turn on Always On for the camera."
  },
  {
    question: "How is it different from Sony Creators' App or Imaging Edge Mobile?",
    answer: "It is built around one job: keeping location data on your photos. It reconnects on its own, can sync the camera clock and trigger the shutter, and is open source with no ads and no account. It does not transfer photos, so keep using Sony's app to copy photos to your phone."
  },
  {
    question: "Can I use a camera that was set up with Creators' App before?",
    answer: "Usually yes. Just pair it in the app. If it connects but the camera doesn't receive location, remove the camera from your phone's Bluetooth settings and from the Sony app, then pair it again."
  },
  {
    question: "Is it free?",
    answer: "Yes. It is free, open source (GPL-3.0) and has no ads. Your location is only used to geotag photos on your camera, and crash reports are only sent if you allow them."
  }
];

// One entry per store: a combined "Android, iOS" entry with two download URLs
// can't say which listing belongs to which platform. These describe the
// published Alpha GPS app.
const appJsonLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Alpha GPS for Geotagging",
  applicationCategory: "PhotographyApplication",
  description:
    "Open-source Sony camera geotagging app that transmits GPS coordinates from your phone to your camera.",
  url: upstreamSiteUrl,
  sameAs: [upstreamRepoUrl, releasesUrl],
  featureList: features,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD"
  },
  publisher: {
    "@type": "Person",
    name: "Saschl"
  }
};
const jsonLd = [
  {
    ...appJsonLd,
    operatingSystem: "Android",
    softwareRequirements: `${minAndroid} or later`,
    downloadUrl: playStoreUrl,
    installUrl: playStoreUrl
  },
  {
    ...appJsonLd,
    operatingSystem: "iOS",
    softwareRequirements: `${minIos} or later`,
    downloadUrl: appStoreUrl,
    installUrl: appStoreUrl
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map(({ question, answer }) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer }
    }))
  }
];
---

<BaseLayout
  title="GeoShutter – open-source geotagging for Sony cameras"
  description="GeoShutter, a fork of Alpha GPS: open-source app that sends your phone's GPS coordinates to Sony cameras over Bluetooth, on Android and iOS."
  jsonLd={jsonLd}
  appleAppId={appStoreId}
  nav={topNav}
>
  <section class="hero">
    <h1>GeoShutter</h1>
    <p class="lead">
      Open-source geotagging and remote shutter for Sony cameras, on iPhone and
      Android. Pair once and automatically get accurate GPS coordinates for your
      photos.
    </p>
    <p class="muted">
      GeoShutter is a fork of <a href={upstreamSiteUrl}>Alpha GPS</a> by Saschl.
      The app is published as Alpha GPS, so the buttons below install Alpha GPS.
    </p>
    <div class="actions">
      <a class="button" href={playStoreUrl}>Get Alpha GPS on Google Play</a>
      <a class="button" href={appStoreUrl}>Get Alpha GPS on the App Store</a>
      <a class="button ghost" href={releasesUrl}>Alpha GPS APK releases</a>
    </div>
  </section>

  <section>
    <h2>Why people use it</h2>
    <div class="grid">
      <article class="card">
        <h3>Reliable background updates</h3>
        <p>
          Uses platform-specific mechanisms to keep location updates running in the background, even with aggressive battery optimizations.
        </p>
      </article>
      <article class="card">
        <h3>Works with supported Sony models</h3>
        <p>
          Built for cameras that work with Imaging Edge or Sony Creators' app,
          with confirmed reports including {confirmedCameraNames}.{" "}
          <a href="#cameras">See supported cameras</a>.
        </p>
      </article>
      <article class="card">
        <h3>Practical troubleshooting</h3>
        <p>
          Includes a step-by-step troubleshooting guide, logs, and an optional
          Always On mode for tricky vendor-specific Android behavior.
        </p>
      </article>
    </div>
  </section>

  <section>
    <h2>On iPhone and Android</h2>
    <p>
      The app runs on iPhones with {minIos} or later and on Android phones with {minAndroid}
      or later (automatic background reconnect needs Android 12 or later, or Always On
      mode on older versions). Features on both:
    </p>
    <ul>
      {features.map((feature) => <li>{feature}</li>)}
    </ul>
  </section>

  <section id="cameras">
    <h2>Supported cameras</h2>
    <p>
      The app works with Sony Alpha, ILCE and ZV cameras that can receive
      location information from Imaging Edge Mobile or Creators' App. It uses
      the same Bluetooth location feature, so if Sony's app can geotag your
      camera, this app should too.
    </p>
    <p>Confirmed by users so far:</p>
    <ul>
      {confirmedCameras.map((camera) => (
        <li>{camera.name}{camera.code !== camera.name && <span class="muted"> ({camera.code})</span>}</li>
      ))}
    </ul>
    <p class="muted">
      Using a camera that isn't listed? <a href={issuesUrl}>Let us know</a> whether
      it works, so it can be added.
    </p>
  </section>

  <section id="faq" class="faq">
    <h2>Frequently asked questions</h2>
    {faq.map(({ question, answer }) => (
      <>
        <h3>{question}</h3>
        <p>{answer}</p>
      </>
    ))}
  </section>

  <section>
    <h2>Open source, community built</h2>
    <p>
      GeoShutter is fully open source under the GPL-3.0 and builds on Alpha GPS.
      You can inspect the code, open issues, propose improvements, and help
      translate the app. No paywalls, no ads, no data selling.
    </p>
    <div class="actions">
      <a class="button" href={repoUrl}>Source Code</a>
      <a class="button ghost" href={issuesUrl}>Issue Tracker</a>
      <a class="button ghost" href={upstreamRepoUrl}>Upstream: Alpha GPS</a>
      <a class="button ghost" href={weblateUrl}>Translate on Weblate</a>
    </div>
  </section>

  <section>
    <h2>Privacy first</h2>
    <ul>
      <li>No advertising or data selling.</li>
      <li>Location is used only while a camera is connected, for live geotag transfer to your camera.</li>
      <li>Crash reports are opt-in, and the FOSS Android build has no crash reporter at all.</li>
      <li>You can turn error reporting off in the app settings at any time.</li>
    </ul>
    <p class="muted">
      Full details: <a href={privacyUrl}>Privacy Policy</a>
    </p>
  </section>

  <section>
    <h2>Support the original author</h2>
    <p>
      GeoShutter builds on Alpha GPS by Saschl. If the app helps your photo
      workflow, support its ongoing development and maintenance.
    </p>
    <div class="actions">
      <a class="button" href={supportUrl}>Buy Me a Coffee</a>
    </div>
    <small>GeoShutter is maintained by sarmadjari, based on Alpha GPS by Saschl and contributors.</small>
  </section>
</BaseLayout>
